{
  "name": "tpendency",
  "version": "2.0.0-rc.1",
  "description": "Async dependency injector for JavaScript & TypeScript with full type-safety",
  "author": "Björn Zeutzheim",
  "license": "MIT",
  "homepage": "https://github.com/olee/tpendency#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olee/tpendency.git"
  },
  "bugs": {
    "url": "https://github.com/olee/tpendency/issues"
  },
  "type": "module",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "shx rm -Rf lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "shx rm -Rf lib && tsc -p tsconfig.build.json && tsup",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "pnpm run build"
  },
  "files": [
    "lib/",
    "src/",
    "LICENSE",
    "pnpm-lock.yaml",
    "README.md",
    "tsconfig.build.json",
    "tsconfig.json",
    "tsup.config.ts"
  ],
  "keywords": [
    "dependency-injection",
    "di",
    "typescript",
    "async",
    "type-safe"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "shx": "^0.3.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
